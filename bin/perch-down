#!/bin/bash
# Stops what bin/perch-up started: the strip, the agent and the agent's Ghostty focus watcher.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA="$HOME/Library/Application Support/perch-terminal"
AGENT="$ROOT/.build/perch-terminal/perch"
OVERLAY="$ROOT/.build/release/tomari-overlay"

# running <pid file> <binary>: prints the pid when that binary runs under it.
running() {
  local pid
  pid="$(cat "$1" 2>/dev/null)" || return 1
  [[ -n "$pid" ]] && [[ "$(ps -p "$pid" -o command= 2>/dev/null)" == "$2"* ]] && echo "$pid"
}

# stop <label> <pid file> <binary>
stop() {
  local pid
  if ! pid="$(running "$2" "$3")"; then
    echo "$1: not running"
    rm -f "$2"
    return
  fi
  kill "$pid"
  for _ in $(seq 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
  rm -f "$2"
  echo "$1: stopped (pid $pid)"
}

stop "strip" "$DATA/overlay.pid" "$OVERLAY"
stop "agent" "$DATA/agent.pid" "$AGENT"

# The agent stops its watcher on the way out; this catches one left behind by a crash.
if pkill -f "perch-terminal focus watcher"; then echo "focus watcher: stopped a leftover one"; fi
